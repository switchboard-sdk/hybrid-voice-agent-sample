# Switchboard SDK credentials
#
# scripts/postinstall.js copies this file to .env on install.
# Demo credentials are included to make getting started easier.
#
# Once your app is ready, register it to get your own credentials at
# https://console.switchboard.audio/register

EXPO_PUBLIC_SWITCHBOARD_APP_ID=
EXPO_PUBLIC_SWITCHBOARD_APP_SECRET=

# Cloud brain
#
# An OpenAI API key. Required only for the cloud brain — the on-device one needs
# nothing here. Get one at https://platform.openai.com/api-keys
#
# EXPO_PUBLIC_* variables are compiled into the JS bundle and can be extracted
# from a shipped app, so a key here is not a secret. Read "Cloud credentials" in
# the README before using a key that matters.

EXPO_PUBLIC_CLOUD_LLM_API_KEY=

# Optional. Defaults to gpt-4o-mini, and to OpenAI's chat completions endpoint.
# Point the URL at a proxy you control to keep the key off the device.

EXPO_PUBLIC_CLOUD_LLM_MODEL=
EXPO_PUBLIC_CLOUD_LLM_BASE_URL=

# On-device model
#
# Optional. Where the app fetches the language model on first launch. Defaults to
# a public mirror of the same Llama 3.2 1B build the SDK used to bundle. Point it
# at your own host to serve the weights yourself — see "The language model" in the
# README, which also covers what overriding it gives up.

EXPO_PUBLIC_LLM_MODEL_URL=
