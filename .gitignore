# OSX
.DS_Store

# Node
node_modules/

# Expo
.expo/
dist/
web-build/

# Native projects — generated by `expo prebuild`. Anchored to the repo root so
# the native module's own modules/*/ios/ sources stay tracked.
/ios/
/android/

# Switchboard SDK frameworks — downloaded by scripts/postinstall.js.
# No model weights or binaries in git.
modules/*/ios/Frameworks/

# TypeScript
*.tsbuildinfo

# Credentials
.env

# App Store Connect API key ID and issuer, read by scripts/testflight.js
.env.appstore

# Local Xcode node path override
.xcode.env.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude Code session memory
memory/
